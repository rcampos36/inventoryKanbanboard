// Prisma schema for Inventory Kanban Board (Neon Postgres)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/** A dealership / customer tenant on the shared AutoSync database. */
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /** Franchise brand for new-car model lanes (e.g. Mazda, Honda). */
  brand     String   @default("Mazda")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  cars        Car[]
  salespeople Salesperson[]
  managers    Manager[]
  settings    AppSettings?
}

model Car {
  id              String   @id @default(cuid())
  organizationId  String
  stockNumber     String
  year            Int
  make            String
  model           String
  trim            String
  condition       String
  columnId        String
  salespersonId   String?
  coSalespersonId String?
  soldAt          String?
  managerId       String?
  workingDealId   String?
  overnightId     String?
  outDate         String?
  returnDate      String?
  tagNumber       String?
  /** Inventory column to restore when an overnight demo is returned. */
  homeColumnId    String?
  /** Exterior paint / body color name of the vehicle. */
  exteriorColor   String?
  price           Int?
  position        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, stockNumber])
  @@index([organizationId])
  @@index([columnId])
  @@index([salespersonId])
  @@index([coSalespersonId])
  @@index([managerId])
  @@index([workingDealId])
  @@index([overnightId])
  @@index([soldAt])
}

/** One settings row per dealership. */
model AppSettings {
  id             String   @id @default(cuid())
  organizationId String   @unique
  openSalesDay   String
  boardTitle     String   @default("Pearson Mazda Inventory and Sales Board")
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String   @unique
  name           String
  passwordHash   String
  role           UserRole @default(USER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/** Dealership sales team members shown on the board. */
model Salesperson {
  organizationId String
  id             String
  name           String
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, id])
  @@index([organizationId])
}

/** Dealership managers shown on the manager-demo lanes. */
model Manager {
  organizationId String
  id             String
  name           String
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, id])
  @@index([organizationId])
}
