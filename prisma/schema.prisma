// Prisma schema for Inventory Kanban Board (Neon Postgres)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Car {
  id              String   @id @default(cuid())
  stockNumber     String
  year            Int
  make            String
  model           String
  trim            String
  condition       String
  columnId        String
  salespersonId   String?
  coSalespersonId String?
  soldAt          String?
  managerId       String?
  workingDealId   String?
  overnightId     String?
  outDate         String?
  returnDate      String?
  tagNumber       String?
  /** Inventory column to restore when an overnight demo is returned. */
  homeColumnId    String?
  /** Optional chip accent color id (rose, yellow, blue, …). */
  chipColor       String?
  price           Int?
  position        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([columnId])
  @@index([salespersonId])
  @@index([coSalespersonId])
  @@index([managerId])
  @@index([workingDealId])
  @@index([overnightId])
  @@index([soldAt])
}

/** Singleton row (id = "default") for board-wide settings. */
model AppSettings {
  id           String   @id @default("default")
  openSalesDay String
  updatedAt    DateTime @updatedAt
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
