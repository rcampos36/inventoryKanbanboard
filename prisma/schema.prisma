// Prisma schema for Inventory Kanban Board (Neon Postgres)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlanId {
  starter
  professional
  enterprise
}

enum PlanStatus {
  trialing
  active
  past_due
  canceled
}

/** A dealership / customer tenant on the shared SalesTower database. */
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /** Franchise brand for new-car model lanes (e.g. Mazda, Honda). */
  brand     String   @default("Mazda")
  /** Selected subscription tier (Stripe billing can attach later). */
  plan      PlanId   @default(professional)
  planStatus PlanStatus @default(trialing)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  cars        Car[]
  salespeople Salesperson[]
  managers    Manager[]
  events      BoardEvent[]
  settings    AppSettings?
}

model Car {
  id              String   @id @default(cuid())
  organizationId  String
  stockNumber     String
  year            Int
  make            String
  model           String
  trim            String
  condition       String
  columnId        String
  salespersonId   String?
  coSalespersonId String?
  soldAt          String?
  managerId       String?
  workingDealId   String?
  overnightId     String?
  outDate         String?
  returnDate      String?
  tagNumber       String?
  /** Inventory column to restore when an overnight demo is returned. */
  homeColumnId    String?
  /** Exterior paint / body color name of the vehicle. */
  exteriorColor   String?
  price           Int?
  position        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, stockNumber])
  @@index([organizationId])
  @@index([columnId])
  @@index([salespersonId])
  @@index([coSalespersonId])
  @@index([managerId])
  @@index([workingDealId])
  @@index([overnightId])
  @@index([soldAt])
}

/** One settings row per dealership. */
model AppSettings {
  id             String   @id @default(cuid())
  organizationId String   @unique
  openSalesDay   String
  boardTitle     String   @default("Pearson Mazda Inventory and Sales Board")
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String   @unique
  name           String
  passwordHash   String
  role           UserRole @default(USER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/** Dealership sales team members shown on the board. */
model Salesperson {
  organizationId String
  id             String
  name           String
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, id])
  @@index([organizationId])
}

/** Dealership managers shown on the manager-demo lanes. */
model Manager {
  organizationId String
  id             String
  name           String
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, id])
  @@index([organizationId])
}

/** Inbound “Schedule a Demo” leads from the marketing site. */
model DemoRequest {
  id          String   @id @default(cuid())
  name        String
  email       String
  dealership  String
  phone       String?
  message     String?  @db.Text
  emailSent   Boolean  @default(false)
  emailError  String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

/**
 * Singleton marketing copy for the public SalesTower landing page.
 * Edited from /admin/landing by the platform (Pearson) admin.
 */
model LandingPageContent {
  id                  String   @id @default("default")
  heroHeadline        String
  heroSubcopy         String   @db.Text
  aboutEyebrow        String
  aboutTitle          String
  aboutBody           String   @db.Text
  featuresEyebrow     String
  featuresTitle       String
  /** JSON array of { eyebrow, title, body }. */
  featuresJson        Json
  bottomEyebrow       String
  bottomTitle         String
  bottomBody          String   @db.Text
  pitchEyebrow        String
  /** Rich HTML for the pitch body (headings, lists, paragraphs). */
  pitchHtml           String   @default("") @db.Text
  /** Legacy plain paragraphs — kept for migration fallback. */
  pitchParagraphsJson Json
  footerTagline       String
  updatedAt           DateTime @updatedAt
}

/**
 * Durable history for reports (sales + inventory movement).
 * Events are append-only so unselling a car does not erase past sales.
 */
model BoardEvent {
  id              String   @id @default(cuid())
  organizationId  String
  /** sale | sale_reversed | inventory_added | inventory_moved */
  type            String
  /** YYYY-MM-DD when the event happened. */
  occurredAt      String
  /** YYYY-MM for fast monthly filters. */
  monthKey        String
  carId           String?
  stockNumber     String?
  make            String?
  model           String?
  trim            String?
  condition       String?
  fromColumnId    String?
  toColumnId      String?
  salespersonId   String?
  coSalespersonId String?
  price           Int?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, monthKey])
  @@index([organizationId, type, monthKey])
  @@index([organizationId, carId])
}
