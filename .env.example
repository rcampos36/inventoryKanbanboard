# Copy to .env / .env.local for local, and set the same keys in Vercel → Settings → Environment Variables.

# Pooled connection (app runtime / Prisma Client)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct connection (migrations via prisma migrate deploy)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Session signing secret (generate with: openssl rand -base64 32)
AUTH_SECRET="replace-me"

# Password to unlock the /demo sales sandbox board
DEMO_BOARD_PASSWORD="change-me-demo"

# Administrator for the default dealership (Pearson Mazda)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"
ADMIN_NAME="Administrator"

# A second demo dealership (Sunrise Honda) is created automatically:
#   admin@sunrise.local / sunrise123

# Demo request form email (https://resend.com)
# Testing (no domain yet): use Resend's test sender + YOUR Resend account email
RESEND_API_KEY="re_xxxxxxxx"
DEMO_FROM_EMAIL="SalesTower <onboarding@resend.dev>"
DEMO_TO_EMAIL="your-resend-login-email@gmail.com"
#
# Production (after verifying salestower.io at resend.com/domains):
# DEMO_FROM_EMAIL="SalesTower <hello@salestower.io>"
# DEMO_TO_EMAIL="info@salestower.io"

