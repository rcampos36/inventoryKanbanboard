# Copy to .env / .env.local for local, and set the same keys in Vercel → Settings → Environment Variables.

# Pooled connection (app runtime / Prisma Client)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct connection (migrations via prisma migrate deploy)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Session signing secret (generate with: openssl rand -base64 32)
AUTH_SECRET="replace-me"

# Administrator for the default dealership (Pearson Mazda)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"
ADMIN_NAME="Administrator"

# A second demo dealership (Sunrise Honda) is created automatically:
#   admin@sunrise.local / sunrise123

# Demo request form → emails info@salestower.io (https://resend.com)
# 1) Create an API key in Resend
# 2) Verify the salestower.io domain (required to send TO info@salestower.io)
# 3) Set DEMO_FROM_EMAIL to an address on that verified domain
RESEND_API_KEY="re_xxxxxxxx"
DEMO_FROM_EMAIL="SalesTower <hello@salestower.io>"
DEMO_TO_EMAIL="info@salestower.io"

