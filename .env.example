# Copy to .env / .env.local for local, and set the same keys in Vercel → Settings → Environment Variables.

# Pooled connection (app runtime / Prisma Client)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct connection (migrations via prisma migrate deploy)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Auth.js (required in Vercel Production + Preview)
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-with: openssl rand -base64 32"
# Optional on Vercel (auto-detected with trustHost). Set explicitly if needed:
# AUTH_URL="https://your-app.vercel.app"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: https://your-app.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
