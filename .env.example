# Copy to .env / .env.local for local, and set the same keys in Vercel → Settings → Environment Variables.

# Pooled connection (app runtime / Prisma Client)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct connection (migrations via prisma migrate deploy)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Session signing secret (generate with: openssl rand -base64 32)
AUTH_SECRET="replace-me"

# Administrator account (source of truth — password is synced from these on each deploy/login)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"
ADMIN_NAME="Administrator"
